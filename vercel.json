{
  "functions": {
    "api/tryon.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/frontend/src/index.html"
    },
    {
      "source": "/styles.css",
      "destination": "/frontend/src/styles.css"
    },
    {
      "source": "/app.js",
      "destination": "/frontend/src/app.js"
    },
    {
      "source": "/assets/:path*",
      "destination": "/frontend/src/assets/:path*"
    }
  ]
}
